rules_version = '2';
// Acceso por solicitud y aprobación:
// - Cualquier cuenta de Google con el correo verificado puede pedir acceso: crea su propia
//   ficha en "entrenadores" (id del documento = correo en minúsculas) sin poder darse permisos.
// - Solo entra quien el administrador (campo admin: true) aprueba (aprobado: true).
// - El administrador puede retirar el acceso (bloqueado: true).
// - La web de estadísticas usa las mismas reglas para la sección Entrenamientos.
service cloud.firestore {
  match /databases/{database}/documents {
    function correo() {
      return request.auth.token.email.lower();
    }
    function logueado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function ficha() {
      return /databases/$(database)/documents/entrenadores/$(correo());
    }
    function esEntrenador() {
      return logueado() && exists(ficha())
        && get(ficha()).data.get('bloqueado', false) != true
        && (get(ficha()).data.get('aprobado', false) == true || get(ficha()).data.get('admin', false) == true);
    }
    function esAdmin() {
      return esEntrenador() && get(ficha()).data.get('admin', false) == true;
    }

    match /entrenadores/{email} {
      // La propia ficha siempre se puede leer (para saber si está bloqueada)
      allow read: if esEntrenador() || (logueado() && email == correo());
      // Solicitud de acceso: solo nombre y fechas; nunca admin, aprobado ni bloqueado
      allow create: if logueado() && email == correo()
        && request.resource.data.keys().hasOnly(['nombre', 'alta', 'ultimo']);
      // El entrenador actualiza su último acceso; el administrador puede cambiar cualquier ficha
      allow update: if esAdmin()
        || (esEntrenador() && email == correo()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'nombre']));
      allow delete: if esAdmin();
    }

    // Estilos propios (p. ej. «piernas»): cualquier entrenador los crea; solo el administrador los borra
    match /estilos/{id} {
      allow read, create, update: if esEntrenador();
      allow delete: if esAdmin();
    }

    // Compartir en directo con las familias: copia pública de UN entrenamiento, que se lee solo conociendo
    // su código (24 caracteres al azar en la dirección). No se puede listar la colección, solo se lee mientras
    // esté activa y sin caducar (campo hasta, en milisegundos), y solo los entrenadores aprobados la escriben.
    // Dejar de compartir borra el documento y el enlace deja de funcionar al instante.
    match /directo_pub/{token} {
      allow get: if resource.data.activo == true && request.time.toMillis() < resource.data.hasta;
      allow create, update: if esEntrenador() && token.matches('[a-z0-9]{24}')
        && request.resource.data.activo == true
        && request.resource.data.resultados.size() <= 3000;
      allow delete: if esEntrenador();
    }

    match /{coleccion}/{doc} {
      allow read, write: if esEntrenador()
        && coleccion in ['equipos', 'nadadores', 'sesiones', 'grupos', 'gnads', 'resultados', 'plantillas', 'planes', 'borrados'];
    }
  }
}
